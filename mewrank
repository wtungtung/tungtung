    -- Hàm đọc dữ liệu từ UI gốc & ẩn UI gốc tự động
    local function SyncFromOriginalLabel(obj)
        if obj:IsDescendantOf(ScreenGui) then return end
        if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
        local raw = obj.Text
        if type(raw) ~= "string" or raw == "" then return end

        local plain = raw:gsub("<[^>]+>", ""):gsub("^%s*(.-)%s*$", "%1")
        local lower = plain:lower()

        -- Nhận diện ScreenGui của script gốc để ẩn gọn
        if plain:find("Hatching:") or plain:find("Hatched Eggs:") or plain:find("^Quests:") or lower:find("eblan") then
            local sg = obj:FindFirstAncestorOfClass("ScreenGui")
            if sg and sg ~= ScreenGui then
                state.origGui = sg
                if not state.showOrig then
                    sg.Enabled = false
                end
            end
        end

        -- Phân loại dữ liệu đưa lên các thẻ Bento
        if plain:find("^Hatching:") then
            HatchingValue.Text = plain
        elseif plain:match("^%d%d:%d%d:%d%d$") then
            state.hasRemoteTimer = true
            TimerPill.Text = "⏱ " .. plain
        elseif plain:find("Gems:") or plain:find("Bars:") then
            if plain:find("Gems:") and plain:find("Bars:") then
                ValGems.Text = plain
            elseif plain:find("Gems:") then
                state.gems = plain
                ValGems.Text = state.bars and (state.gems .. "\n" .. state.bars) or state.gems
            elseif plain:find("Bars:") then
                state.bars = plain
                ValGems.Text = state.gems and (state.gems .. "\n" .. state.bars) or state.bars
            end
        elseif plain:find("Hatched Eggs:") then
            ValEggs.Text = plain:gsub("^Hatched Eggs:%s*", "")
        elseif plain:find("Zone:") then
            state.zone = plain
            ValZone.Text = plain:gsub("^Zone:%s*", "")
        elseif plain:find("Rank:") or plain:find("Rebirth:") then
            if plain:find("Rank:") and plain:find("Rebirth:") then
                ValRank.Text = plain
            elseif plain:find("Rank:") then
                state.rank = plain
                ValRank.Text = state.rebirth and (state.rank .. "\n" .. state.rebirth) or state.rank
            elseif plain:find("Rebirth:") then
                state.rebirth = plain
                ValRank.Text = state.rank and (state.rank .. "\n" .. state.rebirth) or state.rebirth
            end
        elseif plain:find("^Quests:") then
            ValQuests.Text = plain:gsub("^Quests:%s*", "")
        end
    end

    local function HookOriginalElement(obj)
        if obj:IsDescendantOf(ScreenGui) then return end
        if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
        if obj:GetAttribute("Mew29Synced") then return end
        obj:SetAttribute("Mew29Synced", true)

        pcall(SyncFromOriginalLabel, obj)
        obj:GetPropertyChangedSignal("Text"):Connect(function()
            pcall(SyncFromOriginalLabel, obj)
        end)
    end

    local function WatchRoot(root)
        if not root then return end
        task.spawn(function()
            pcall(function()
                for i, d in ipairs(root:GetDescendants()) do
                    HookOriginalElement(d)
                    if i % 150 == 0 then task.wait() end
                end
                root.DescendantAdded:Connect(HookOriginalElement)
            end)
        end)
    end

    WatchRoot(CoreGui)
    local hui = gethui and gethui()
    if hui and hui ~= CoreGui then
        WatchRoot(hui)
    end
end

