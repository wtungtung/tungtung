                if shown == 0 then
                    create("TextLabel", {
                        Size = UDim2.new(1, 0, 0, 26),
                        BackgroundTransparency = 1,
                        Text = "(Không có mục phù hợp)",
                        TextColor3 = Theme.Muted,
                        Font = Enum.Font.Gotham,
                        TextSize = 12,
                    }, optScroll)
                end
            end

            function control:Set(val, silent)
                local nextList = {}
                if isMulti then
                    if type(val) == "table" then
                        for _, item in ipairs(val) do
                            local s = tostring(item)
                            if s ~= "" and not table.find(nextList, s) then
                                table.insert(nextList, s)
                            end
                        end
                    elseif type(val) == "string" and val ~= "" then
                        table.insert(nextList, val)
                    end
                else
                    local chosen = val
                    if type(val) == "table" then chosen = val[1] end
                    if type(chosen) == "string" and chosen ~= "" then
                        nextList = { chosen }
                    end
                end
                self.value = nextList
                updateDisplay()
                rebuildItems()
                if not silent and type(cfg.callback) == "function" then
                    if isMulti then
                        local copy = {}
                        for i, v in ipairs(nextList) do copy[i] = v end
                        task.spawn(cfg.callback, copy)
                    else
                        task.spawn(cfg.callback, nextList[1] or "")
                    end
                end
                scheduleSave()
            end

            function control:Refresh(newOptions)
                currentOptions = type(newOptions) == "table" and newOptions or {}
                rebuildItems()
            end

            header.MouseButton1Click:Connect(function()
                expanded = not expanded
                arrow.Text = expanded and "▴" or "▾"
                local panelHeight = math.clamp(#currentOptions * 29 + 52, 108, 178)
                listPanel.Size = UDim2.new(1, -16, 0, panelHeight)
                tween(container, { Size = UDim2.new(1, 0, 0, expanded and (panelHeight + 52) or 42) }, 0.15)
                tween(stroke, { Color = expanded and Theme.Accent or Theme.Border }, 0.15)
            end)

            searchBox:GetPropertyChangedSignal("Text"):Connect(rebuildItems)

            control:Set(cfg.value, true)
            ui:RegisterControl(cfg.flag, "dropdown", control)
            return control
        end

        return tabObj
    end

    return ui
end

