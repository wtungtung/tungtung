    }, topbar)
    addCorner(activeBadge, 12)
    addStroke(activeBadge, Theme.Border, 1)

    local function setVisible(visible)
        mainFrame.Visible = visible
        miniPill.Visible = not visible
    end

    local minBtn = create("TextButton", {
        Size = UDim2.fromOffset(30, 26),
        Position = UDim2.new(1, -78, 0.5, -13),
        BackgroundColor3 = Theme.Card,
        Text = "—",
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        AutoButtonColor = false,
    }, topbar)
    addCorner(minBtn, 6)
    minBtn.MouseButton1Click:Connect(function() setVisible(false) end)

    local closeBtn = create("TextButton", {
        Size = UDim2.fromOffset(30, 26),
        Position = UDim2.new(1, -42, 0.5, -13),
