    -- Khu vực thân (Sidebar + Nội dung)
    local body = create("Frame", {
        Size = UDim2.new(1, 0, 1, -48),
        Position = UDim2.new(0, 0, 0, 48),
        BackgroundTransparency = 1,
    }, mainFrame)

    local sidebar = create("ScrollingFrame", {
        Name = "Sidebar",
        Size = UDim2.new(0, 158, 1, 0),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Border,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, body)
    create("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
    }, sidebar)
    create("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, sidebar)

    create("Frame", {
        Size = UDim2.new(0, 1, 1, 0),
        Position = UDim2.new(0, 158, 0, 0),
        BackgroundColor3 = Theme.Border,
        BorderSizePixel = 0,
    }, body)

    local contentHolder = create("Frame", {
        Name = "ContentHolder",
        Size = UDim2.new(1, -159, 1, 0),
        Position = UDim2.new(0, 159, 0, 0),
        BackgroundTransparency = 1,
    }, body)

    -- Bộ quản lý Registry & Config
    local ui = {
        ready = false,
        controls = {},
        order = {},
        buttons = {},
        toggles = {},
    }

    local configPath = (options.fileName or "RobloxHubUI") .. "_Modern.json"
    local autoSaveEnabled = options.autoSave == true
    local savePending = false

    local function scheduleSave()
        if not autoSaveEnabled or not ui.ready or savePending or type(writefile) ~= "function" then return end
        savePending = true
        task.delay(0.35, function()
            savePending = false
            pcall(function()
                writefile(configPath, HttpService:JSONEncode(ui:Snapshot()))
            end)
        end)
    end

    local function updateActiveBadge()
        local count = 0
        for _, entry in pairs(ui.toggles) do
            if entry.control.value == true then count += 1 end
        end
        activeBadge.Text = "Đang bật: " .. tostring(count)
    end

    function ui:RegisterControl(flag, kind, control, runner)
        if type(flag) ~= "string" or flag == "" then return end
        if not self.controls[flag] then
            table.insert(self.order, flag)
        end
        local entry = { flag = flag, kind = kind, control = control, runner = runner }
        self.controls[flag] = entry
        if kind == "toggle" then self.toggles[flag] = entry end
        if kind == "button" then self.buttons[flag] = entry end
    end

    function ui:Snapshot()
        local snap = {}
        for _, flag in ipairs(self.order) do
            local entry = self.controls[flag]
            if entry and entry.kind ~= "button" and entry.kind ~= "text" then
                local val = entry.control.value
                if entry.kind == "dropdown" then
                    if entry.control._multi then
                        local copy = {}
                        for i, v in ipairs(val) do copy[i] = v end
                        snap[flag] = copy
                    else
                        snap[flag] = val[1] or ""
                    end
                else
                    snap[flag] = val
                end
            end
        end
        return snap
    end

    function ui:Apply(saved, mode)
        if type(saved) ~= "table" then return end
        for _, flag in ipairs(self.order) do
            local entry = self.controls[flag]
            local value = saved[flag]
            if entry and value ~= nil then
                local isToggle = entry.kind == "toggle"
                if (mode == "values" and not isToggle and entry.kind ~= "button")
                    or (mode == "toggles" and isToggle)
                    or mode == nil then
                    if entry.control.Set then
                        entry.control:Set(value, false)
                    end
                end
            end
        end
    end

    function ui:Run(actions)
        if type(actions) ~= "table" then return end
        if #actions > 0 then
            for _, flag in ipairs(actions) do
                local entry = self.buttons[flag]
                if entry and entry.runner then pcall(entry.runner) end
            end
        else
            for flag, shouldRun in pairs(actions) do
                if shouldRun then
                    local entry = self.buttons[flag]
                    if entry and entry.runner then pcall(entry.runner) end
                end
            end
        end
    end

    function ui:LoadLocalConfig()
        if not options.autoLoad or type(readfile) ~= "function" then return end
        if type(isfile) == "function" and not isfile(configPath) then return end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(configPath)) end)
        if ok and type(data) == "table" then
            self:Apply(data, "values")
            self:Apply(data, "toggles")
        end
    end

    function ui:DisableAllToggles()
        for _, entry in pairs(self.toggles) do
            if entry.control.value == true then
                entry.control:Set(false)
            end
        end
    end

    function ui:GetActiveFlags()
        local active = {}
        for _, flag in ipairs(self.order) do
            local entry = self.toggles[flag]
            if entry and entry.control.value == true then
                table.insert(active, flag)
            end
        end
        return active
    end

    -- Quản lý Tab
    local tabs = {}
    local activeTab = nil

    local function selectTab(tabObj)
        for _, item in ipairs(tabs) do
            local isTarget = (item == tabObj)
            item.page.Visible = isTarget
            tween(item.button, {
                BackgroundColor3 = isTarget and Theme.Card or Theme.Sidebar,
                BackgroundTransparency = isTarget and 0 or 1,
            })
            tween(item.label, { TextColor3 = isTarget and Theme.Text or Theme.Muted })
            tween(item.indicator, { BackgroundTransparency = isTarget and 0 or 1 })
        end
        activeTab = tabObj
    end

    function ui:CreateTab(name, iconText)
        local btn = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Theme.Sidebar,
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = #tabs + 1,
        }, sidebar)
        addCorner(btn, 8)

        local indicator = create("Frame", {
            Size = UDim2.new(0, 3, 0, 18),
            Position = UDim2.new(0, 4, 0.5, -9),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
        }, btn)
        addCorner(indicator, 2)

        local label = create("TextLabel", {
            Size = UDim2.new(1, -20, 1, 0),
            Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1,
            Text = (iconText and (iconText .. "  ") or "") .. name,
            TextColor3 = Theme.Muted,
            Font = Enum.Font.GothamSemibold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, btn)

        local page = create("ScrollingFrame", {
            Name = "Page_" .. name,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = Theme.Border,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
        }, contentHolder)
        create("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 16),
            PaddingLeft = UDim.new(0, 14),
            PaddingRight = UDim.new(0, 16),
        }, page)
        create("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, page)

        local tabObj = {
            name = name,
            button = btn,
            label = label,
            indicator = indicator,
            page = page,
            _order = 0,
        }

        local function nextOrder()
            tabObj._order += 1
            return tabObj._order
        end

        btn.MouseButton1Click:Connect(function() selectTab(tabObj) end)
        table.insert(tabs, tabObj)
        if not activeTab then selectTab(tabObj) end

        -- Section Header
        function tabObj:CreateSection(cfg)
            local holder = create("Frame", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundTransparency = 1,
                LayoutOrder = nextOrder(),
            }, page)
            create("TextLabel", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = string.upper(tostring(cfg.name or "")),
                TextColor3 = Theme.AccentGlow,
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, holder)
            create("Frame", {
                Size = UDim2.new(1, 0, 0, 1),
                Position = UDim2.new(0, 0, 1, -1),
                BackgroundColor3 = Theme.Border,
                BackgroundTransparency = 0.4,
                BorderSizePixel = 0,
            }, holder)
            return holder
        end

        -- Group proxy (tương thích trading:CreateGroup)
        function tabObj:CreateGroup()
            return self
        end

        -- Text / Status Card
        function tabObj:CreateText(cfg)
            local card = create("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Theme.Card,
                BorderSizePixel = 0,
                LayoutOrder = nextOrder(),
            }, page)
