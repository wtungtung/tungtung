            "Người chơi: %s\nThời gian chạy: %02d:%02d:%02d  |  FPS: %d  |  Ping: %dms\nServer: %d/%d người  |  Anti-AFK: %s\nPhím ẩn/hiện nhanh: RightShift",
            Players.LocalPlayer.Name, h, m, s, fps, ping,
            #Players:GetPlayers(), Players.MaxPlayers, afkInfo
        ))

        local active = ui:GetActiveFlags()
        activeListText:Set(#active > 0 and table.concat(active, ", ") or "(Chưa có tính năng nào được bật)")
    end)
end

