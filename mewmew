        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    }, guiParent)
    environment.RobloxHubCustomGui = screenGui

    -- Cửa sổ chính
    local mainFrame = create("Frame", {
        Name = "Mew 29HaNoi",
        Size = UDim2.fromOffset(720, 470),
        Position = UDim2.new(0.5, -360, 0.5, -235),
        BackgroundColor3 = Theme.Bg,
        BorderSizePixel = 0,
