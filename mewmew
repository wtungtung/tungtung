                            Font = selected and Enum.Font.GothamSemibold or Enum.Font.Gotham,
                            TextSize = 12,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            TextTruncate = Enum.TextTruncate.AtEnd,
                        }, itemBtn)

                        itemBtn.MouseButton1Click:Connect(function()
                            if isMulti then
                                local idx = table.find(control.value, optStr)
                                if idx then
                                    table.remove(control.value, idx)
                                else
                                    table.insert(control.value, optStr)
                                end
                                control:Set(control.value, false)
                            else
                                control:Set(optStr, false)
                                expanded = false
                                arrow.Text = "▾"
                                tween(container, { Size = UDim2.new(1, 0, 0, 42) }, 0.14)
                                tween(stroke, { Color = Theme.Border }, 0.14)
                            end
